name: real-data-smoke

on:
  workflow_dispatch:
  pull_request:
    paths:
      - code/ai_pilot/data_pipeline/real_city_smoke.py
      - code/ai_pilot/data_pipeline/tests/test_real_city_smoke.py
      - .github/workflows/real-data-smoke.yml

jobs:
  unit:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Run deterministic smoke checks
        run: |
          python code/ai_pilot/data_pipeline/real_city_smoke.py --self-test
          python -m unittest discover \
            -s code/ai_pilot/data_pipeline/tests \
            -p 'test_real_city_smoke.py' -v

  live:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Query official Chicago and NYC releases
        run: |
          python code/ai_pilot/data_pipeline/real_city_smoke.py \
            --output-dir tmp/real-city-smoke \
            --max-rows 5000 \
            --max-market-nodes 12 \
            --require-all
      - name: Upload smoke-test evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: real-city-smoke
          path: tmp/real-city-smoke
          if-no-files-found: warn
