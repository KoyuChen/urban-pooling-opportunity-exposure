    "request_timeout_seconds": 45,
    "window_deadline_seconds": 900,
    "max_parallel": 4,
    "retry_rule": "Keep every attempt; re-run only TRANSPORT_FAILURE or TRANSPORT_DEADLINE, never completed or scientifically ineligible windows. No replacement dates."
  },
  "denominator": "24 declared cells, 20 distinct scan windows; stress cells overlap broad cells and are not independent. Keep NOT_STARTED, IN_PROGRESS, scientific exclusions and transfer failures. Do not convert prior outcome ineligibility into current geometry ineligibility without re-extraction.",
  "next_comparison_rule": "No outcome solves in this census. Any subsequent comparison protocol must retain all geometry classes in its denominator and establish full-world feasibility separately.",
  "publication": "Aggregate per-window JSON, ledger CSV, report and TeX only; input hashes and code hashes; no raw rows, identifiers or event witnesses."
