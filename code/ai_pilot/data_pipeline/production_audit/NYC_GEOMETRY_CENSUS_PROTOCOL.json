    "max_indeterminate_rows": 200,
    "rule": "Existing consistent-snapshot extractor with the original per-window minimum core size and public ordering; time/provider/zone projection only. Metadata and candidate counts rechecked after extraction. New snapshot, not byte identity with old outcome panel."
  },
  "views": {
    "full": "First declared 8/16 positive-duration exact-time core rows, all other determinate positive-duration candidates optional buffers.",
    "small": "First 4 cores from full view plus 12 nearest positive-duration buffers by exact temporal gap, pickup, dropoff, source order. No outcome availability or values used. Remaining original cores become optional buffers."
