  "invalid_time_rule": "Report omitted indeterminate and nonpositive-duration rows; insufficient valid cores is scientific ineligibility. Noninteger-second timestamps are OUT_OF_PROTOCOL, not rounded.",
  "metrics": [
    "row/core/buffer counts",
    "overlap edge count and complete-clique status",
    "common overlap duration",
    "connected components and core components",
